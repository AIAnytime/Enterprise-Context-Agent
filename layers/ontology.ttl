# ─────────────────────────────────────────────────────────────
# LAYER 3 · ENTERPRISE ONTOLOGY  —  "How should the business be interpreted?"
# Concepts, hierarchy (is-a), relationships and rules. This is the BLUEPRINT:
# no individual customers or orders live here (they live in the Knowledge Graph).
# ─────────────────────────────────────────────────────────────
@prefix eo:   <https://aianytime.in/ontology/retail#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://aianytime.in/ontology/retail> a owl:Ontology ;
    rdfs:label "Anytime Appliances enterprise ontology" ;
    eo:businessOwner "Chief Data Office" .

# ── Concepts (classes) and hierarchy ───────────────────────────
eo:Customer a owl:Class ; rdfs:label "Customer" ;
    skos:altLabel "dealer", "retailer", "account" ;
    skos:definition "A business that buys from us." ;
    eo:mapsTo "customers" .

eo:PremiumCustomer a owl:Class ; rdfs:subClassOf eo:Customer ;
    rdfs:label "Premium Customer" ;
    skos:altLabel "key account", "premium", "top customer", "VIP" ;
    skos:definition "A Customer in the Platinum or Gold segment." ;
    eo:mapsTo "customers.segment IN ('Platinum','Gold')" .

eo:PlatinumCustomer a owl:Class ; rdfs:subClassOf eo:PremiumCustomer ;
    rdfs:label "Platinum Customer" ; eo:mapsTo "customers.segment = 'Platinum'" .

eo:GoldCustomer a owl:Class ; rdfs:subClassOf eo:PremiumCustomer ;
    rdfs:label "Gold Customer" ; eo:mapsTo "customers.segment = 'Gold'" .

eo:Order a owl:Class ; rdfs:label "Order" ;
    skos:definition "A purchase placed by a Customer." ; eo:mapsTo "sales_data" .

eo:Product a owl:Class ; rdfs:label "Product" ; skos:altLabel "SKU", "item" ; eo:mapsTo "products" .
eo:CoolingAppliance a owl:Class ; rdfs:subClassOf eo:Product ; rdfs:label "Cooling Appliance" ;
    skos:altLabel "AC", "refrigerator", "cooler" ; eo:mapsTo "products.category = 'Cooling'" .
eo:KitchenAppliance a owl:Class ; rdfs:subClassOf eo:Product ; rdfs:label "Kitchen Appliance" ; eo:mapsTo "products.category = 'Kitchen'" .
eo:HomeAppliance a owl:Class ; rdfs:subClassOf eo:Product ; rdfs:label "Home Appliance" ; eo:mapsTo "products.category = 'Home'" .

eo:Supplier a owl:Class ; rdfs:label "Supplier" ; skos:altLabel "vendor" ; eo:mapsTo "suppliers" .
eo:Warehouse a owl:Class ; rdfs:label "Warehouse" ; skos:altLabel "DC", "distribution centre" .
eo:Region a owl:Class ; rdfs:label "Sales Region" ; skos:altLabel "zone" .
eo:State a owl:Class ; rdfs:label "State / UT" .
eo:Revenue a owl:Class ; rdfs:label "Revenue" ;
    skos:definition "Value generated by a non-cancelled Order. Calculated by the Semantic Layer metric 'revenue'." ;
    eo:mapsTo "semantic_layer.metrics.revenue" .

# ── Relationships (object properties) ─────────────────────────
eo:places     a owl:ObjectProperty ; rdfs:label "places"      ; rdfs:domain eo:Customer ; rdfs:range eo:Order .
eo:contains   a owl:ObjectProperty ; rdfs:label "contains"    ; rdfs:domain eo:Order    ; rdfs:range eo:Product .
eo:generates  a owl:ObjectProperty ; rdfs:label "generates"   ; rdfs:domain eo:Order    ; rdfs:range eo:Revenue .
eo:suppliedBy a owl:ObjectProperty ; rdfs:label "supplied by" ; rdfs:domain eo:Product  ; rdfs:range eo:Supplier .
eo:shipsTo    a owl:ObjectProperty ; rdfs:label "ships to"    ; rdfs:domain eo:Supplier ; rdfs:range eo:Warehouse .
eo:servedBy   a owl:ObjectProperty ; rdfs:label "served by"   ; rdfs:domain eo:Customer ; rdfs:range eo:Warehouse .
eo:locatedIn  a owl:ObjectProperty ; rdfs:label "located in"  ; rdfs:domain eo:Customer ; rdfs:range eo:State .
eo:partOf     a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "part of" ; rdfs:domain eo:State ; rdfs:range eo:Region .

# ── Business rules & constraints ──────────────────────────────
eo:BusinessRule a owl:Class ; rdfs:label "Business Rule" .
eo:rule_cancel a eo:BusinessRule ; rdfs:label "Cancelled orders never generate Revenue" ;
    eo:appliesTo eo:Order, eo:Revenue ; eo:owner "Finance" .
eo:rule_premium a eo:BusinessRule ; rdfs:label "Premium status is decided by segment, not by a single month's spend" ;
    eo:appliesTo eo:PremiumCustomer ; eo:owner "Sales Ops" .
eo:rule_region a eo:BusinessRule ; rdfs:label "Region membership follows the Sales Ops 2024 map. Goa is WEST, Telangana and Puducherry are SOUTH" ;
    eo:appliesTo eo:Region ; eo:owner "Sales Ops" .
eo:rule_dc a eo:BusinessRule ; rdfs:label "Each customer is served by exactly one distribution centre, the one for its region" ;
    eo:appliesTo eo:Warehouse, eo:Customer ; eo:owner "Supply Chain" .

# ── Reference data: the company's own definition of regions ──
eo:SouthIndia a eo:Region ; rdfs:label "South India" ;
    skos:altLabel "South", "Dakshin", "southern region", "SI" ;
    skos:definition "Sales region: Karnataka, Tamil Nadu, Kerala, Andhra Pradesh, Telangana + UT of Puducherry (5 states + 1 UT)." .
eo:NorthIndia a eo:Region ; rdfs:label "North India" ; skos:altLabel "North" .
eo:WestIndia  a eo:Region ; rdfs:label "West India"  ; skos:altLabel "West" .
eo:EastIndia  a eo:Region ; rdfs:label "East India"  ; skos:altLabel "East" .

eo:KA a eo:State ; rdfs:label "Karnataka"      ; eo:code "KA" ; eo:partOf eo:SouthIndia .
eo:TN a eo:State ; rdfs:label "Tamil Nadu"     ; eo:code "TN" ; eo:partOf eo:SouthIndia .
eo:KL a eo:State ; rdfs:label "Kerala"         ; eo:code "KL" ; eo:partOf eo:SouthIndia .
eo:AP a eo:State ; rdfs:label "Andhra Pradesh" ; eo:code "AP" ; eo:partOf eo:SouthIndia .
eo:TG a eo:State ; rdfs:label "Telangana"      ; eo:code "TG" ; eo:partOf eo:SouthIndia .
eo:PY a eo:State ; rdfs:label "Puducherry"     ; eo:code "PY" ; eo:partOf eo:SouthIndia .
eo:DL a eo:State ; rdfs:label "Delhi"          ; eo:code "DL" ; eo:partOf eo:NorthIndia .
eo:HR a eo:State ; rdfs:label "Haryana"        ; eo:code "HR" ; eo:partOf eo:NorthIndia .
eo:UP a eo:State ; rdfs:label "Uttar Pradesh"  ; eo:code "UP" ; eo:partOf eo:NorthIndia .
eo:PB a eo:State ; rdfs:label "Punjab"         ; eo:code "PB" ; eo:partOf eo:NorthIndia .
eo:MH a eo:State ; rdfs:label "Maharashtra"    ; eo:code "MH" ; eo:partOf eo:WestIndia .
eo:GJ a eo:State ; rdfs:label "Gujarat"        ; eo:code "GJ" ; eo:partOf eo:WestIndia .
eo:GA a eo:State ; rdfs:label "Goa"            ; eo:code "GA" ; eo:partOf eo:WestIndia .
eo:WB a eo:State ; rdfs:label "West Bengal"    ; eo:code "WB" ; eo:partOf eo:EastIndia .
eo:OD a eo:State ; rdfs:label "Odisha"         ; eo:code "OD" ; eo:partOf eo:EastIndia .
